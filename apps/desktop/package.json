{
  "name": "@orix/desktop",
  "version": "1.0.1",
  "description": "Offline-first desktop retail management system for Windows.",
  "author": {
    "name": "ORIX TECH"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm build:main && pnpm build:preload && vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=esm --external:electron --external:better-sqlite3 --outfile=dist/main/index.js --sourcemap && esbuild src/main/diagnostics/bootstrap.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main/diagnostics.cjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "pack:win": "pnpm build && electron-builder --win dir --x64",
    "smoke": "env -u ELECTRON_RUN_AS_NODE electron . --smoke",
    "typecheck": "tsc -b",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=preload.cjs"
  },
  "dependencies": {
    "@orix/application": "workspace:*",
    "@orix/business": "workspace:*",
    "@orix/core": "workspace:*",
    "@orix/database": "workspace:*",
    "@orix/electron": "workspace:*",
    "@orix/migration": "workspace:*",
    "@orix/repositories": "workspace:*",
    "@orix/shared": "workspace:*",
    "@orix/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "downshift": "^9.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "vite": "^8.3.1"
  },
  "main": "electron-main.cjs"
}
