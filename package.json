{
  "name": "orix-retail-os",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first desktop Retail Management System for Windows.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "desktop:smoke": "pnpm --filter @orix/desktop smoke",
    "dist:win": "pnpm --filter @orix/desktop dist:win",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migration:legacy-stock:preview": "pnpm --filter @orix/migration build && node packages/migration/dist/cli/ospos-preview.js",
    "pack:win": "pnpm --filter @orix/desktop pack:win",
    "prepare": "husky",
    "test": "pnpm native:node && pnpm build && vitest run",
    "test:coverage": "pnpm native:node && pnpm build && vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc -b",
    "seed:demo": "pnpm native:node && pnpm build && node scripts/seed-demo.mjs",
    "desktop:demo": "node scripts/start-demo.mjs",
    "native:node": "node scripts/prepare-node.mjs",
    "audit:security": "pnpm audit --audit-level=moderate",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,md,mdx,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
